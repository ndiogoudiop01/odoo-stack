###############################################################################
#  Configuration du client — copiez ce fichier en .env et complétez-le.
#  Le .env n'est JAMAIS commité (voir .gitignore).
#
#  Sur Coolify / Dokploy : ne mettez pas ce fichier sur le serveur.
#  Recopiez ces variables dans l'écran « Environment Variables » de la
#  ressource ; celles marquées 🔒 doivent être marquées secrètes.
###############################################################################

# ======================= IDENTITÉ ==========================================
CLIENT_SLUG=acme                 # minuscules, sans espace : sert de préfixe partout
CLIENT_NAME="ACME SARL"          # nom lisible (documentation uniquement)
ODOO_VERSION=19.0                # 17.0 | 18.0 | 19.0
POSTGRES_VERSION=16              # 15 pour Odoo 16, 16 pour Odoo 17/18/19
TZ=Africa/Dakar

# ======================= IMAGE DE BASE =====================================
# Image construite depuis VOS dépôts privés Odoo :
#     ./base-images/build.sh 19.0 enterprise --push
# Le VPS doit pouvoir la tirer : docker login ghcr.io -u <owner>
ODOO_BASE_IMAGE=ghcr.io/odooafia/odoo:19.0-enterprise

# ======================= DOMAINE & REVERSE-PROXY ===========================
DOMAIN=erp.acme.sn               # sans https://

# Réseau et points d'entrée du Traefik de la plateforme :
#   Coolify  -> TRAEFIK_NETWORK=coolify          HTTP=http      HTTPS=https
#   Dokploy  -> TRAEFIK_NETWORK=dokploy-network  HTTP=web       HTTPS=websecure
#   Docker   -> TRAEFIK_NETWORK=traefik          HTTP=web       HTTPS=websecure
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ======================= BASE DE DONNÉES ===================================
DB_USER=odoo
DB_PASSWORD=                     # 🔒 généré par new-client.sh
DB_NAME=acme_prod                # base par défaut (mono-base par client)
DB_FILTER=^acme_prod$            # verrouille la base servie par ce domaine
DB_MAXCONN=64
LIST_DB=False                    # False en production : masque le sélecteur de base

# ======================= SÉCURITÉ ==========================================
ODOO_MASTER_PASSWORD=            # 🔒 mot de passe maître (/web/database/manager)

# ======================= PERFORMANCE =======================================
# Règle empirique : workers = (2 x nb_cores) + 1, puis ajuster.
# Chaque worker consomme ~250-400 Mo. LIMIT_MEMORY_* est PAR worker.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
LIMIT_MEMORY_SOFT=2147483648     # 2 Go
LIMIT_MEMORY_HARD=2684354560     # 2,5 Go
LIMIT_TIME_CPU=600
LIMIT_TIME_REAL=1200
LIMIT_TIME_REAL_CRON=0
LIMIT_REQUEST=8192

# PostgreSQL (adapter à la RAM du VPS)
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_LOG_SLOW_MS=2000              # journalise les requêtes > 2 s

# ======================= JOURNALISATION ====================================
ODOO_LOG_LEVEL=info              # info | debug | warn
ODOO_LOG_HANDLER=:INFO
SERVER_WIDE_MODULES=base,web
WITHOUT_DEMO=all                 # jamais de données de démo en production
ODOO_EXTRA_ARGS=

# ======================= SAUVEGARDES =======================================
BACKUP_ENABLED=true
BACKUP_HOUR=2                    # heure locale du dump quotidien
BACKUP_RETENTION_DAYS=14
BACKUP_ENC_PASSPHRASE=           # 🔒 si renseigné, archives chiffrées AES-256

# ======================= DÉVELOPPEMENT LOCAL ===============================
# Ports attribués par le registre central (registry/clients.tsv).
# Utilisés uniquement par `make dev`, jamais en production.
HTTP_PORT=8069
LONGPOLLING_PORT=8072
PROXY_PORT=8080
PG_PORT=5432
DEBUGPY_PORT=5678
ODOO_DEBUGPY=0
ODOO_DEBUGPY_WAIT=0
